DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/post_offer_engagement
APP_ENV=development

# Module 5 — AI service.
# LLM_PROVIDER selects the implementation in backend/app/ai/provider.py.
# With GEMINI_API_KEY unset the app still runs: every AI endpoint returns its
# deterministic rule-based fallback with was_fallback=true.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
